# Trip Wallet Backend Configuration Template
# Copy this file to .env and configure appropriately for your environment.

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://tripwallet:tripwallet_password@localhost:5432/tripwallet

# Secret Key for JWT Token Generation (Use a strong random 32+ char secret in production)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars

# Environment: "development" | "production"
ENVIRONMENT=development

# Allowed CORS Origins: comma-separated list of origins (or * for local dev)
# Example production: https://tripwallet.app,https://admin.tripwallet.app
CORS_ORIGINS=*

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
